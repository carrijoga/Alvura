# Ignore Visual Studio temporary files, build results, and user-specific files
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build folders
[Bb]in/
[Oo]bj/

# Rider
.idea/

# NuGet
*.nupkg
# The packages folder can be ignored because of PackageReference
packages/

# Visual Studio publish folder
publish/

# Test results
TestResults/
*.trx

# Dotnet local files
*.dotCover
*.ncrunch*
*.Coverage

# Generated files
*.g.cs
GeneratedFiles/

# Logs
*.log

# Runtime files
*.pid
*.pid.lock

# ASP.NET Temporary files
appsettings.*.json

# Rider and JetBrains
*.DotSettings.user

# Mac files
.DS_Store

# Windows image file caches
Thumbs.db

# Node dependencies (if present in project)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local tool/runtime folders
.dotnet/

# Optional: Ignore user-specific JetBrains Rider folders
.idea/

# Ignore Visual Studio Code workspace storage
.vscode/*storage*
